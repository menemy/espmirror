CONFIG_IDF_TARGET="esp32s31"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESPMIRROR_IRIS=y
CONFIG_ESPMIRROR_USB=n
CONFIG_ESPMIRROR_USB_NETWORK=n
CONFIG_ESPMIRROR_TCP=n
CONFIG_ESPMIRROR_AUDIO=n
CONFIG_ESPMIRROR_MSG_KB=8
CONFIG_ESPMIRROR_PREFER_PSRAM=y
CONFIG_ESP_IRIS_ENABLE=y
CONFIG_ESP_IRIS_FIRMWARE_ROLE=1
CONFIG_ESP_IRIS_PRODUCT_CONTRACT="esp-mosaico/v2"
CONFIG_ESP_IRIS_BOARD_ID="esp-mosaico"
CONFIG_ESP_IRIS_LAYOUT_ID="mosaico-retained-test-2m-v2"
CONFIG_ESP_IRIS_RECOVERY_ABI=2
CONFIG_ESP_IRIS_OTA_DEFAULT_VIA_RECOVERY=y
CONFIG_ESP_IRIS_SYSTEM_INVENTORY=y
CONFIG_ESP_IRIS_OTA=n
CONFIG_ESP_IRIS_NVS_PARTITION_NAME="sysmeta"
CONFIG_ESP_IRIS_TRANSPORT_USB=y
CONFIG_ESP_IRIS_TRANSPORT_TCP=n
CONFIG_ESP_IRIS_USB_PRODUCT="ESP-Iris espmirror"
CONFIG_TINYUSB_CDC_COUNT=2
CONFIG_ESP_IRIS_RPC_BODY_BYTES=2048
CONFIG_ESP_IRIS_MEDIA_LATEST_BYTES=3840
CONFIG_ESP_IRIS_MEDIA_BUFFER_PSRAM=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=64
