menu "Virtual display"
    depends on IDF_TARGET_ESP32S3

    config VIRTUAL_WIDTH
        int "Width in pixels"
        range 128 640
        default 240

    config VIRTUAL_HEIGHT
        int "Height in pixels"
        range 128 640
        default 240

    config VIRTUAL_ROUND
        bool "Round screen"
        default n

    config VIRTUAL_DIAGONAL_100
        int "Diagonal in hundredths of an inch (200 = 2.00 inches)"
        range 0 2000
        default 200

    config VIRTUAL_NAME
        string "Name shown in the viewer"
        default "Virtual ESP32-S3"

    config VIRTUAL_BOOT_GPIO
        int "BOOT GPIO, active low (-1 disables)"
        range -1 48
        default 0
        help
            GPIO0 on the XIAO ESP32S3 and ESP32-S3-DevKitC-1.
            Release BOOT while resetting to run the application.

    config VIRTUAL_WIFI
        bool "Join a Wi-Fi network; the mirror listens on TCP too"
        depends on SPIRAM
        select ESPMIRROR_TCP
        default n
        help
            Needs PSRAM (Component config > ESP PSRAM, octal on the XIAO
            ESP32S3 and the DevKitC-1 N8R8). Without it the 240 x 240 mirror
            leaves Wi-Fi too little internal RAM to start.

    config VIRTUAL_WIFI_SSID
        string "Wi-Fi network"
        depends on VIRTUAL_WIFI

    config VIRTUAL_WIFI_PASSWORD
        string "Wi-Fi password"
        depends on VIRTUAL_WIFI
endmenu
