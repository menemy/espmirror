# The ESP-Mosaico: its 480 x 480, 2.16-inch screen and its three keys. The screen copy needs PSRAM
# (octal on the XIAO ESP32S3 and the ESP32-S3-DevKitC-1 N8R8):
# rm -f sdkconfig; idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.mosaico" build
CONFIG_VIRTUAL_DEVICE_ESP_MOSAICO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
